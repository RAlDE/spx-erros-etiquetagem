{
  "manifest_version": 3,
  "name": "SPX — Erros de Etiquetagem",
  "short_name": "ETQ SPX",
  "version": "0.1.2",
  "description": "Ranking de operadores por último recebimento normal com expedições VT AM/PM.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://spx.shopee.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ETQ — Abrir ranking de erros de etiquetagem",
    "default_icon": {
      "16": "icons/etq128.png",
      "32": "icons/etq128.png",
      "48": "icons/etq128.png",
      "128": "icons/etq128.png"
    }
  },
  "icons": {
    "16": "icons/etq128.png",
    "48": "icons/etq128.png",
    "128": "icons/etq128.png"
  }
}
