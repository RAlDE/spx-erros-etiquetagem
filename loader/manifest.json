{
  "manifest_version": 3,
  "name": "SPX — Erros de Etiquetagem",
  "short_name": "ETQ SPX",
  "version": "0.2.0",
  "minimum_chrome_version": "138",
  "description": "Carregador ETQ: atualizar ranking pelo GitHub, com AM/PM por VT.",
  "permissions": ["storage", "tabs", "userScripts"],
  "host_permissions": [
    "https://spx.shopee.com.br/*",
    "https://raw.githubusercontent.com/RAlDE/spx-erros-etiquetagem/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "ETQ — Atualização pelo GitHub",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/etq128.png", "32": "icons/etq128.png", "48": "icons/etq128.png", "128": "icons/etq128.png"}
  },
  "icons": {"16": "icons/etq128.png", "48": "icons/etq128.png", "128": "icons/etq128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
